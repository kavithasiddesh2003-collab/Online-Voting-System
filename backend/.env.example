# Copy to backend/.env and adjust. Omit MYSQL_* to use SQLite (database/database.db) for local dev.

JWT_SECRET_KEY=change-me-in-production
OTP_HMAC_SALT=change-otp-salt

# MySQL — set MYSQL_HOST and MYSQL_DATABASE to enable MySQL (see database/schema.sql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=online_voting

# Email OTP (optional). If SMTP_HOST is empty, OTP is printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com
SMTP_USE_TLS=1
SMTP_SUBJECT=Your BallotHub login code

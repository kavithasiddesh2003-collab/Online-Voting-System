# Copy to backend/.env and adjust. Omit MYSQL_* to use SQLite (database/database.db) for local dev.

JWT_SECRET_KEY=change-me-in-production
OTP_HMAC_SALT=change-otp-salt
HMAC_SIGNING_KEY=change-this-signing-key

# MSG91 (for SMS OTP). If left blank, the OTP is printed to the server console
# instead of being sent — useful for local development and testing.
MSG91_API_KEY=

# MySQL — set MYSQL_HOST and MYSQL_DATABASE to enable MySQL (see database/schema.sql).
# Leave both blank to use SQLite instead.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=securevote
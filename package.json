{
  "name": "securevote",
  "version": "1.0.0",
  "private": true,
  "description": "SecureVote monorepo: runs backend + frontend together",
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "scripts": {
    "start": "concurrently -n backend,frontend -c \"cyan,green\" \"python backend/run.py\" \"npm --prefix frontend start\"",
    "start:backend": "python backend/run.py",
    "start:frontend": "npm --prefix frontend start",
    "install:frontend": "npm --prefix frontend install"
  },
  "dependencies": {
    "eslint": "^10.2.0"
  }
}
